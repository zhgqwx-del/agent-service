# systemd EnvironmentFile example; replace EVERY __...__ marker privately.
# Install as /etc/agent-service/agent-router.env, root-owned 0600. Never copy runner's whole env.
NODE_ENV=production
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8080
RUNNERS=http://127.0.0.1:8787
REDIS_URL="redis://agent_router:__URL_ENCODED_REDIS_ROUTER_PASSWORD__@127.0.0.1:6379/0"
REDIS_PREFIX=agent_service_prod
REDIS_NAMESPACE_ID=single-linux-db0
INTERNAL_ROUTER_TOKEN=__REPLACE_SHARED_RANDOM_INTERNAL_TOKEN_32_TO_256_ASCII__
MAX_BODY_BYTES=1000000
SHUTDOWN_GRACE_MS=10000
BLOB_STORE=filesystem
BLOB_NAMESPACE_ID=initial-text-only
BLOB_FILESYSTEM_SINGLE_RUNNER=0
BLOB_STORAGE_CONTROL_ENABLED=0
BLOB_ATTACHMENTS_ENABLED=0
SKILL_REGISTRY_ENABLED=0
DATA_EXPORT_REQUESTS_ENABLED=0
MCP_REGISTRY_ENABLED=0
TENANT_HOOKS_ENABLED=0
LIFECYCLE_HOOKS_ENABLED=0
SUBAGENTS_ENABLED=0
PROVIDER_GATEWAY_ENABLED=1
PROVIDER_GATEWAY_POLICY_SHA256=__READ_FINAL_POLICY_SHA256_FROM_VERIFIED_RUNNER__
# Runner quota JSON/key pool/provider credentials must NOT be copied into router.
PERSISTED_PROVIDER_FAILURE_CAPTURE_FLEET_ENABLED=0
SESSION_USAGE_RETENTION_ENABLED=0

# Required private L0 metrics for this deployment profile; not turn-success or billing telemetry.
METRICS_ENABLED=1
METRICS_BEARER_TOKEN=__REPLACE_ROUTER_METRICS_TOKEN_32_TO_256_ASCII__
# No MYSQL_*, provider/API_KEY, SECRETS_MASTER_KEY, bootstrap, AWS/S3 credentials,
# AUTHORITY_*, SCHEMA_* or operator-only credentials in this role.
