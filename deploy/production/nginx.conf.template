# Include inside nginx's http {} context. This is a template, not an installed configuration.
# Replace all markers; use an existing trusted TLS certificate/key and actual backend egress CIDR.
# Proposed conservative edge limits require host validation; they are NOT provider/model-spend quotas.
limit_req_zone $binary_remote_addr zone=agent_service_req:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=agent_service_per_ip:10m;
limit_conn_zone $server_name zone=agent_service_total:1m;
upstream agent_service_router {
    server 127.0.0.1:8080;
    keepalive 16;
}
server {
    listen 443 ssl;
    server_name __API_HOSTNAME__;
    ssl_certificate __TLS_FULLCHAIN_FILE__;
    ssl_certificate_key __TLS_PRIVATE_KEY_FILE__;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != "__API_HOSTNAME__") { return 421; }

    # The service key and trusted-caller user ID belong to an operator/App BACKEND, never a browser.
    allow __TRUSTED_CALLER_EGRESS_CIDR__;
    deny all;
    access_log off; # no URI/session IDs/query/headers/body/credentials in access logs
    error_log /var/log/nginx/agent-service-error.log crit;
    client_max_body_size 1000000;
    client_body_timeout 15s;
    client_header_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn agent_service_per_ip 32;
    limit_conn agent_service_total 64;

    location = /metrics { return 404; }
    location ^~ /metrics/ { return 404; }
    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }
    location = /_internal { return 404; }
    location ^~ /_internal/ { return 404; }
    location = /_router { return 404; }
    location ^~ /_router/ { return 404; }
    location /v1/ {
        limit_req zone=agent_service_req burst=10 nodelay;
        proxy_pass http://agent_service_router; # preserve complete /v1 path, no replacement URI
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Agent-Service-Internal-Token "";
        proxy_buffering off;
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_ignore_client_abort off;
        proxy_next_upstream off; # no automatic replay of a possibly-started POST
        proxy_read_timeout 75s; # idle interval, above the configured 10s SSE heartbeat
        proxy_send_timeout 30s;
    }
    location / { return 404; }
}
# No plaintext HTTP listener, public runner port, public metrics or automatic certificate issuance.
