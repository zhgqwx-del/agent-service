# Example only: use an existing Prometheus on this same host/network namespace.
# Copy to a protected operator-selected path; no service is installed by this file.
# Enable METRICS_ENABLED=1 on BOTH roles before admitting production traffic.
global:
  scrape_interval: 15s
  scrape_timeout: 5s
  evaluation_interval: 15s

rule_files:
  - /etc/agent-service/monitoring/alerts.yml

scrape_configs:
  - job_name: agent-router
    scheme: http
    metrics_path: /metrics
    follow_redirects: false
    authorization:
      type: Bearer
      credentials_file: /etc/agent-service/monitoring/router.metrics.bearer
    static_configs:
      - targets: ['127.0.0.1:8080']

  - job_name: agent-runner
    scheme: http
    metrics_path: /metrics
    follow_redirects: false
    authorization:
      type: Bearer
      credentials_file: /etc/agent-service/monitoring/runner.metrics.bearer
    static_configs:
      - targets: ['127.0.0.1:8787']
