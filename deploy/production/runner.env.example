# systemd EnvironmentFile example; NOT a shell script. Replace EVERY __...__ marker privately.
# Install as /etc/agent-service/agent-runner.env, root-owned 0600; do not source or log it.
NODE_ENV=production
STORE=mysql
MYSQL_URL="mysql://agent_runtime:__URL_ENCODED_RUNTIME_PASSWORD__@127.0.0.1:3306/agent_service"
MYSQL_SCHEMA_METADATA_SCHEMA=agent_service_metadata
MYSQL_SCHEMA_METADATA_DEFINER_USER=agent_metadata_definer
MYSQL_SCHEMA_METADATA_DEFINER_HOST=localhost
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8787
RUNNER_ID=runner-single-1
RUNNER_ADDR=127.0.0.1:8787
REDIS_URL="redis://agent_runner:__URL_ENCODED_REDIS_RUNNER_PASSWORD__@127.0.0.1:6379/0"
REDIS_PREFIX=agent_service_prod
REDIS_NAMESPACE_ID=single-linux-db0
INTERNAL_ROUTER_TOKEN=__REPLACE_SHARED_RANDOM_INTERNAL_TOKEN_32_TO_256_ASCII__
SECRETS_MASTER_KEY=__REPLACE_INDEPENDENT_RANDOM_64_HEX_MASTER_KEY__

# One supported provider example, not a vendor recommendation. Use your chosen priced model.
# Provider credential belongs only to runner. Do not override API_BASE_URL accidentally.
PLATFORM_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat
API_KEY=__REPLACE_AUTHORIZED_VENDOR_KEY__
MAX_BODY_BYTES=1000000

# Text-only initial profile: no production filesystem writes, cleanup, skills or exports.
BLOB_STORE=filesystem
BLOB_DIR=/var/lib/agent-service/agent-runner/blobs
BLOB_NAMESPACE_ID=initial-text-only
BLOB_FILESYSTEM_SINGLE_RUNNER=0
BLOB_STORAGE_CONTROL_ENABLED=0
BLOB_ATTACHMENTS_ENABLED=0
BLOB_CLEANUP_ENABLED=0
SKILL_REGISTRY_ENABLED=0
DATA_EXPORT_REQUESTS_ENABLED=0
DATA_EXPORT_WORKER_ENABLED=0
DATA_EXPORT_CLEANUP_ENABLED=0
MCP_ENABLED=0
MCP_REGISTRY_ENABLED=0
TENANT_HOOKS_ENABLED=0
LIFECYCLE_HOOKS_ENABLED=0
SUBAGENTS_ENABLED=0
PROVIDER_GATEWAY_ENABLED=1
# Actual upstream dispatch quota: initial finite example, not a capacity or money guarantee.
PROVIDER_TENANT_QUOTA_JSON='{"rpm":60,"concurrency":2}'
PROVIDER_USER_QUOTA_JSON='{"rpm":30,"concurrency":1}'
PLATFORM_PROVIDER_QUOTA_JSON='{"rpm":60,"concurrency":2}'
ERASURE_ROUTER_URL=http://127.0.0.1:8080
# No PROVIDER_GATEWAY_POLICY_SHA256 here: runner derives its FINAL identity itself.
PERSISTED_PROVIDER_FAILURE_CAPTURE_ENABLED=0
TENANT_TELEMETRY_WRITER_ENABLED=0
SESSION_USAGE_RETENTION_WORKER_ENABLED=0

# Existing SSE resource ceilings; not a process-RSS or model-spend quota.
SSE_HEARTBEAT_MS=10000
SSE_MAX_CONNECTIONS=128
SSE_MAX_CONNECTIONS_PER_TENANT=32
SSE_MAX_QUEUED_EVENTS=256
SSE_MAX_QUEUED_BYTES=4194304
SSE_MAX_FRAME_BYTES=2097152
SSE_MAX_REPLAY_EVENTS=10000
SSE_MAX_REPLAY_BYTES=33554432
SSE_REPLAY_TIMEOUT_MS=30000
SSE_WRITE_STALL_MS=30000

# Required for this initial deployment profile: private L0 metrics and an independent scraper token.
METRICS_ENABLED=1
METRICS_BEARER_TOKEN=__REPLACE_RUNNER_METRICS_TOKEN_32_TO_256_ASCII__
# No BOOTSTRAP_API_KEY, ADMIN_BOOTSTRAP_*, AUTHORITY_*, SCHEMA_*, operator DSN or test flags here.
