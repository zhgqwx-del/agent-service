# INDEPENDENT CONTROLLED ORDINARY RUNNER ONLY; not external-infra run or a schema command.
# Copy to an absolute reviewed 0600 file under an owned 0700 directory; source only in a clean shell.
# All placeholders are intentionally invalid. No project .env, operator DSN/SCHEMA_* or dev BOOTSTRAP_API_KEY.
# Stop every other runner/writer first. Do not run a turn or store Blob data during this first-key step.
NODE_ENV=development
STORE=mysql
MYSQL_URL='<REPLACE_WITH_NEW_ISOLATED_RESTRICTED_RUNTIME_MYSQL_URL_WITH_EXPLICIT_PORT_AND_DATABASE>'
MYSQL_SCHEMA_METADATA_SCHEMA='<REPLACE_WITH_EXISTING_METADATA_SCHEMA>'
MYSQL_SCHEMA_METADATA_DEFINER_USER='<REPLACE_WITH_EXISTING_LOCKED_DEFINER_USER>'
MYSQL_SCHEMA_METADATA_DEFINER_HOST='<REPLACE_WITH_EXACT_LOCKED_DEFINER_HOST>'
RUNNER_HOST=127.0.0.1
RUNNER_PORT='<REPLACE_WITH_UNUSED_RUNNER_PORT>'
RUNNER_ID='<REPLACE_WITH_UNIQUE_BOOTSTRAP_RUNNER_ID>'
RUNNER_ADDR='127.0.0.1:<REPLACE_WITH_UNUSED_RUNNER_PORT>'
REDIS_URL='<REPLACE_WITH_NEW_ISOLATED_LOOPBACK_REDIS_URL_WITH_EXPLICIT_PORT_AND_DB>'
REDIS_PREFIX='<REPLACE_WITH_SAME_UNIQUE_PREFIX>'
REDIS_NAMESPACE_ID='<REPLACE_WITH_SAME_UNIQUE_NAMESPACE_ID>'
INTERNAL_ROUTER_TOKEN='<REPLACE_WITH_SHARED_PRIVATE_RANDOM_INTERNAL_TOKEN>'
SECRETS_MASTER_KEY='<REPLACE_WITH_INDEPENDENT_PRIVATE_64_HEX_MASTER_KEY>'
BLOB_STORE=filesystem
# Existing owned 0700/no-symlink directory; EXACT same stable path as every normal runner startup.
# Independent of each new external-infra --state-dir; never change Blob root merely to restart.
BLOB_DIR='<REPLACE_WITH_ABSOLUTE_EXISTING_PRIVATE_STABLE_BLOB_DIRECTORY>'
BLOB_NAMESPACE_ID='<REPLACE_WITH_SAME_UNIQUE_BLOB_NAMESPACE_ID>'
BLOB_FILESYSTEM_SINGLE_RUNNER=1
BLOB_STORAGE_CONTROL_ENABLED=0
BLOB_ATTACHMENTS_ENABLED=0
BLOB_CLEANUP_ENABLED=0
# Pair for this controlled startup only; output parent exists/private, final file must NOT exist.
ADMIN_BOOTSTRAP_TENANT='<REPLACE_WITH_NEW_LOCAL_TENANT_ID>'
ADMIN_BOOTSTRAP_OUTPUT_FILE='<REPLACE_WITH_ABSOLUTE_PRIVATE_CREATE_ONLY_ADMIN_KEY_FILE>'
# Preserve any output after failure/ambiguous DB commit. Reconcile manually, never overwrite/re-mint.
# Remove BOTH ADMIN_BOOTSTRAP_* keys (not empty strings) before every normal startup.
