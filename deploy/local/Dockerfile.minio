# Build the repository-pinned official MinIO source instead of relying on an unpinned runtime image.
# The S3 compatibility suite and local infrastructure use this exact official Git commit.
# Both base indexes are digest-pinned and contain linux/amd64 plus linux/arm64 variants.
FROM golang:1.24.8-bookworm@sha256:4ed690d6649d63c312b99a6120025ec79ce3b542968a37da53d6236c7c61a848 AS build

ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local

RUN mkdir -p /out \
    && GOBIN=/out go install github.com/minio/minio@07c3a429bfed433e49018cb0f78a52145d4bedeb

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="07c3a429bfed433e49018cb0f78a52145d4bedeb"

COPY --from=build /out/minio /usr/local/bin/minio

EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/minio"]
