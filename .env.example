# LLM (platform default provider, used by dev/tests when no tenant BYOK config exists)
API_KEY=
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen3.8-max

# storage
STORE=mysql
MYSQL_URL=mysql://root@127.0.0.1:3306/agent_service
REDIS_URL=redis://127.0.0.1:6379

# runner
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8787
# Must be unique per live replica. Production generates a UUID if this is omitted.
RUNNER_ID=runner-local-1
# Address advertised to the router/peer runners. Required in production and when RUNNER_HOST is 0.0.0.0/::.
RUNNER_ADDR=127.0.0.1:8787
# Durable terminal-event dispatcher (defaults shown; physical purge is a separate disabled worker).
LIFECYCLE_OUTBOX_POLL_MS=250
LIFECYCLE_OUTBOX_LEASE_MS=10000
LIFECYCLE_OUTBOX_BATCH_SIZE=50
LIFECYCLE_OUTBOX_RETRY_BASE_MS=250
LIFECYCLE_OUTBOX_RETRY_MAX_MS=60000
# Local-only Blob data plane. This explicit acknowledgement is safe only because local-service.sh
# starts exactly one runner with an exclusive filesystem root. Production writes/cleanup fail closed
# until a shared object-store adapter is implemented.
BLOB_DIR=.local-run/blobs
BLOB_FILESYSTEM_SINGLE_RUNNER=1
BLOB_CLEANUP_ENABLED=1
BLOB_ATTACHMENTS_ENABLED=1
BLOB_MAX_BYTES=1000000
BLOB_MAX_HYDRATED_BYTES=4000000
BLOB_TOOL_OUTPUT_THRESHOLD_BYTES=64000
BLOB_STAGING_TTL_MS=3600000
# Subject-level erasure write barrier. Keep off until lifecycle-unaware writers are drained;
# enabling it accepts durable requests that stop at the safe policy boundary, not physical purge.
DATA_ERASURE_REQUESTS_ENABLED=0
# Tenant-wide admission is a separate platform-only authority. Keep the irreversible gate off for
# ordinary local development; manual lifecycle exercises enable it on both processes after the
# full runner fleet is current. This example token is local-only and must never be reused outside it.
TENANT_ERASURE_REQUESTS_ENABLED=0
TENANT_ERASURE_OPERATOR_TOKEN=agent-service-local-platform-operator-token-v1
TENANT_ERASURE_OPERATOR_ID=platform-lifecycle-admin
TENANT_ERASURE_BARRIER_TIMEOUT_MS=2000
# Admin-only canonical retention-policy/legal-hold management. Does not enable purge.
DATA_GOVERNANCE_MANAGEMENT_ENABLED=0
# Builds sealed, non-destructive purge-policy evidence only. Keep disabled until the 0016-aware
# router/runner fleet is fully rolled out; this flag never enables physical purge execution.
PURGE_POLICY_EVALUATOR_ENABLED=0
# User export has an independent admission gate. Local workers remain on while admission is off so
# accepted jobs and TTL cleanup continue draining. The filesystem implementation is single-runner
# only; production refuses these flags until a shared object-store adapter exists.
DATA_EXPORT_REQUESTS_ENABLED=0
DATA_EXPORT_WORKER_ENABLED=1
DATA_EXPORT_CLEANUP_ENABLED=1
# Keep the durable worker independent from new-request admission so an existing gate always
# continues toward the safe awaiting_purge_policy boundary. The local router may start afterward;
# temporary connection failures are retried without exposing this URL or the internal token.
ERASURE_WORKER_ENABLED=1
# Local lifecycle completeness: compensate pre-0009 generation-zero tombstones after the v2 fleet
# barrier. This may activate a durable one-way cutover; production defaults remain off and require
# an expand -> fleet rollout -> activate procedure. It does not enable physical purge.
LEGACY_TOMBSTONE_COMPENSATION_ENABLED=1
ERASURE_ROUTER_URL=http://127.0.0.1:8080
# Keep the timeout stack ordered so a runner can fence local work before the router gives up,
# and the worker can still observe the router's bounded response.
ERASURE_DRAIN_TIMEOUT_MS=10000
ERASURE_WORKER_REQUEST_TIMEOUT_MS=20000
# 32-byte hex master key for encrypting BYOK secrets at rest (dev only; production uses KMS)
# 32-byte hex, required. generate: openssl rand -hex 32
SECRETS_MASTER_KEY=a78521ac63952f57474240c1554b8d62f5d47df5fd3c4ac25a76a2654612683c
# bootstrap service api key -> tenant (dev only)
BOOTSTRAP_API_KEY=dev-key
BOOTSTRAP_TENANT_ID=t_dev

# router (RUNNERS entries are full base URLs, unlike RUNNER_ADDR)
# Shared router→runner credential for local development only. Production must generate a distinct
# header-safe 32–256 character secret and inject the same value into both services.
INTERNAL_ROUTER_TOKEN=agent-service-local-router-token-v1
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8080
RUNNERS=http://127.0.0.1:8787
# Local activation. Production keeps this at 0 until every legacy router is drained and every
# healthy runner advertises tombstone; the router also enforces that fleet capability check.
SESSION_TOMBSTONE_ENABLED=1
# Configure the same value on router and runner so the edge rejects oversized uploads first.
MAX_BODY_BYTES=1000000
