# LLM (platform default provider, used by dev/tests when no tenant BYOK config exists)
API_KEY=
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen3.8-max

# storage
STORE=mysql
MYSQL_URL=mysql://root@127.0.0.1:3306/agent_service
REDIS_URL=redis://127.0.0.1:6379
# All router/runner replicas that share the same logical Redis deployment must use the same
# non-secret identity and prefix. The digest is advertised; the raw identity never grants access.
REDIS_PREFIX=as
REDIS_NAMESPACE_ID=agent-service-local-db0

# runner
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8787
# Must be unique per live replica. Production generates a UUID if omitted while T3b is off; the
# T3b endpoint requires an explicit value that remains stable for this configured runner slot.
RUNNER_ID=runner-local-1
# Address advertised to the router/peer runners. Required in production and when RUNNER_HOST is 0.0.0.0/::.
RUNNER_ADDR=127.0.0.1:8787
# Durable terminal-event dispatcher (defaults shown; physical purge is a separate disabled worker).
LIFECYCLE_OUTBOX_POLL_MS=250
LIFECYCLE_OUTBOX_LEASE_MS=10000
LIFECYCLE_OUTBOX_BATCH_SIZE=50
LIFECYCLE_OUTBOX_RETRY_BASE_MS=250
LIFECYCLE_OUTBOX_RETRY_MAX_MS=60000
# Default local Blob data plane. This acknowledgement is safe only because local-service.sh starts
# one runner with an exclusive filesystem root. For multi-runner/local-production parity, build the
# pinned MinIO binary with scripts/build-local-minio.sh, then use the commented S3 block below.
BLOB_STORE=filesystem
BLOB_DIR=.local-run/blobs
BLOB_FILESYSTEM_SINGLE_RUNNER=1
BLOB_STORAGE_CONTROL_ENABLED=0
# MINIO_ENABLED=1
# BLOB_STORE=s3
# BLOB_NAMESPACE_ID=agent-service-local-minio-v1
# BLOB_FILESYSTEM_SINGLE_RUNNER=0
# BLOB_STORAGE_CONTROL_ENABLED=1
# BLOB_S3_ENDPOINT=http://127.0.0.1:9000
# BLOB_S3_REGION=us-east-1
# BLOB_S3_BUCKET=agent-service-local
# BLOB_S3_PREFIX=agent-service-v1
# BLOB_S3_FORCE_PATH_STYLE=1
# Local MinIO remains 0; production must set 1 only after an independent anonymous-access check.
# BLOB_S3_PRIVATE_BUCKET_ACK=0
# BLOB_S3_REQUEST_TIMEOUT_MS=5000
# BLOB_S3_ACCESS_KEY_ID=agentservice-local
# BLOB_S3_SECRET_ACCESS_KEY=agent-service-local-minio-only-0001

# 0031 authoritative backup catalog. These settings belong only to the foreground
# `pnpm maintenance:backup-catalog -- <command>` operator CLI; local-service.sh removes every
# BACKUP_CATALOG_* value from the long-running router and runner. Keep the catalog bucket distinct
# from both BlobStore and the restore journal. A same-host MinIO bucket is useful for protocol
# testing but is not an independent production failure domain, so the acknowledgement stays blank
# until that property has been verified in the actual deployment.
# BACKUP_CATALOG_ADAPTER=s3
# BACKUP_CATALOG_DATABASE_NAMESPACE_ID=agent-service-local-db
# BACKUP_CATALOG_NAMESPACE_ID=agent-service-local-backup-catalog
# BACKUP_CATALOG_FAILURE_DOMAIN_ID=
# BACKUP_CATALOG_INDEPENDENT_FAILURE_DOMAIN_ACK=
# BACKUP_CATALOG_S3_ENDPOINT=http://127.0.0.1:9000
# BACKUP_CATALOG_S3_REGION=us-east-1
# BACKUP_CATALOG_S3_BUCKET=agent-service-local-backup-catalog
# BACKUP_CATALOG_S3_PREFIX=tenant-backup-catalog
# BACKUP_CATALOG_S3_FORCE_PATH_STYLE=1
# Production only: set to 1 after independently verifying that anonymous/public access is denied.
# BACKUP_CATALOG_S3_PRIVATE_BUCKET_ACK=0
# BACKUP_CATALOG_S3_REQUEST_TIMEOUT_MS=5000
# BACKUP_CATALOG_S3_ACCESS_KEY_ID=
# BACKUP_CATALOG_S3_SECRET_ACCESS_KEY=
# BACKUP_CATALOG_S3_SESSION_TOKEN=
# Required by `activate`; choose policy values deliberately rather than copying these comments.
# BACKUP_CATALOG_MINIMUM_RETENTION_MS=
# BACKUP_CATALOG_MINIMUM_RECOVERABLE_BACKUPS=
# Per-operation inputs are also environment-only and should be exported only for that invocation:
# BACKUP_CATALOG_ACTIVATION_ACK, BACKUP_CATALOG_PAGE_SIZE, BACKUP_CATALOG_AFTER_BACKUP_ID,
# BACKUP_ID, RESTORE_RUN_ID, BACKUP_RUNTIME_EPOCH_ID, SOURCE_SNAPSHOT_SHA256,
# SOURCE_BACKUP_SHA256, BACKUP_ARTIFACT_MANIFEST_SHA256, BACKUP_PROVIDER_EVIDENCE_SHA256,
# BACKUP_EVICTION_ID, EXTERNAL_TOMBSTONE_SHA256, BACKUP_PHYSICAL_ABSENCE_ACK,
# RESTORE_FLEET_STOPPED_ACK. For eviction this acknowledgement must stay at 1 only while every
# writer/catalog operator remains stopped from before prepare-eviction through physical deletion
# and the successful record-eviction commit; it is an operator assertion, not automatic proof.
# A restore operator must retain the exact backup/run/epoch IDs and source evidence outside the
# database so the same prepare-restore can be replayed after restoring an older database snapshot.
BLOB_CLEANUP_ENABLED=1
BLOB_ATTACHMENTS_ENABLED=1
BLOB_MAX_BYTES=1000000
BLOB_MAX_HYDRATED_BYTES=4000000
BLOB_TOOL_OUTPUT_THRESHOLD_BYTES=64000
BLOB_STAGING_TTL_MS=3600000
# Subject-level erasure write barrier. Keep off until lifecycle-unaware writers are drained;
# enabling it accepts durable requests that stop at the safe policy boundary, not physical purge.
DATA_ERASURE_REQUESTS_ENABLED=0
# Tenant-wide admission is a separate platform-only authority. Keep the irreversible gate off for
# ordinary local development; manual lifecycle exercises enable it on both processes after the
# full runner fleet is current. This example token is local-only and must never be reused outside it.
TENANT_ERASURE_REQUESTS_ENABLED=0
TENANT_ERASURE_OPERATOR_TOKEN=agent-service-local-platform-operator-token-v1
TENANT_ERASURE_OPERATOR_ID=platform-lifecycle-admin
TENANT_ERASURE_BARRIER_TIMEOUT_MS=2000
# T3a only: the runner worker removes local database credential material after tenant admission.
# Both sides default off and must be activated together only after every configured runner is
# healthy and advertises the credential-store contract. This never enables tenant-content purge.
TENANT_CREDENTIAL_REVOCATION_WORKER_ENABLED=0
TENANT_CREDENTIAL_REVOCATION_EXECUTION_ENABLED=0
# 0026 versioned credential inventory cutover. Keep 0 while rolling out ledger-aware binaries;
# activate only after every pre-0026 writer is fully drained. The cutover is forward-only and does
# not enable external-provider/KMS revocation by itself.
CREDENTIAL_LIFECYCLE_TRACKING_ENABLED=0
# 0029 external-credential target execution is default-dormant. The standard local-service stack
# uses MySQL and intentionally keeps both gates off. The only current adapter is an in-memory,
# non-production fake used by isolated tests; do not put CREDENTIAL_TARGET_EXECUTION_ADAPTER=fake
# in this file. A real provider adapter and KMS-key execution are not implemented yet.
TENANT_CREDENTIAL_TARGET_EXECUTION_WORKER_ENABLED=0
TENANT_CREDENTIAL_TARGET_EXECUTION_ENABLED=0
# T3b only: every configured stable RUNNERS URL must expose one boot-bound private endpoint before
# the router execution gate is opened. RUNNER_ID is the stable logical slot; bootId is generated per
# process and is never configured. The receipt proves local references/I/O/turns were quiesced, not
# remote-provider cancellation or tenant-content purge.
TENANT_RUNTIME_DRAIN_ENABLED=0
TENANT_RUNTIME_REVOCATION_WORKER_ENABLED=0
TENANT_RUNTIME_DRAIN_EXECUTION_ENABLED=0
TENANT_RUNTIME_DRAIN_TIMEOUT_MS=10000
TENANT_RUNTIME_REVOCATION_REQUEST_TIMEOUT_MS=30000
# T3c only: after a terminal T3b proof, capture a content-free structural owner inventory using
# store/database time. This does not delete or anonymize anything and remains independently off
# until migration 0021 is installed and the new runner binary is everywhere.
TENANT_CONTENT_INVENTORY_WORKER_ENABLED=0
# T3d only: seal a fixed full-domain plan with explicit local/cloud blockers. This planning worker
# has no destructive operation and remains off until migration 0022 and the new runner are present.
TENANT_PURGE_PLAN_WORKER_ENABLED=0
# T3e local-only execution/physical-ACK slice. Both gates stay off until migration 0023 is
# installed everywhere. Enabling the runner also requires Blob/export cleanup; filesystem mode
# additionally requires the explicit single-runner contract. This still cannot mark full purge done.
TENANT_PURGE_EXECUTION_WORKER_ENABLED=0
TENANT_PURGE_EXECUTION_ENABLED=0
TENANT_DATABASE_PURGE_WORKER_ENABLED=0
TENANT_DATABASE_PURGE_ENABLED=0
# T3g removes only the planned Redis lease/fence/stream domains and installs permanent markers.
# Keep both gates off until migration 0025 is applied and every configured process is marker-aware.
TENANT_REDIS_PURGE_WORKER_ENABLED=0
TENANT_REDIS_PURGE_ENABLED=0
# Admin-only canonical retention-policy/legal-hold management. Does not enable purge.
DATA_GOVERNANCE_MANAGEMENT_ENABLED=0
# Builds sealed, non-destructive purge-policy evidence only. Keep disabled until the 0016-aware
# router/runner fleet is fully rolled out; this flag never enables physical purge execution.
PURGE_POLICY_EVALUATOR_ENABLED=0
# User export has an independent admission gate. Local workers remain on while admission is off so
# accepted jobs and TTL cleanup continue draining. Filesystem remains single-runner only; S3/MinIO
# requires the write-once database control and an exact fleet namespace capability match.
DATA_EXPORT_REQUESTS_ENABLED=0
DATA_EXPORT_WORKER_ENABLED=1
DATA_EXPORT_CLEANUP_ENABLED=1
# Keep the durable worker independent from new-request admission so an existing gate always
# continues toward the safe awaiting_purge_policy boundary. The local router may start afterward;
# temporary connection failures are retried without exposing this URL or the internal token.
ERASURE_WORKER_ENABLED=1
# Local lifecycle completeness: compensate pre-0009 generation-zero tombstones after the v2 fleet
# barrier. This may activate a durable one-way cutover; production defaults remain off and require
# an expand -> fleet rollout -> activate procedure. It does not enable physical purge.
LEGACY_TOMBSTONE_COMPENSATION_ENABLED=1
ERASURE_ROUTER_URL=http://127.0.0.1:8080
# Keep the timeout stack ordered so a runner can fence local work before the router gives up,
# and the worker can still observe the router's bounded response.
ERASURE_DRAIN_TIMEOUT_MS=10000
ERASURE_WORKER_REQUEST_TIMEOUT_MS=20000
# 32-byte hex master key for encrypting BYOK secrets at rest (dev only; production uses KMS)
# 32-byte hex, required. generate: openssl rand -hex 32
SECRETS_MASTER_KEY=a78521ac63952f57474240c1554b8d62f5d47df5fd3c4ac25a76a2654612683c
# bootstrap service api key -> tenant (dev only)
BOOTSTRAP_API_KEY=dev-key
BOOTSTRAP_TENANT_ID=t_dev

# router (RUNNERS entries are full base URLs, unlike RUNNER_ADDR)
# Shared router→runner credential for local development only. Production must generate a distinct
# header-safe 32–256 character secret and inject the same value into both services.
INTERNAL_ROUTER_TOKEN=agent-service-local-router-token-v1
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8080
RUNNERS=http://127.0.0.1:8787
# Local activation. Production keeps this at 0 until every legacy router is drained and every
# healthy runner advertises tombstone; the router also enforces that fleet capability check.
SESSION_TOMBSTONE_ENABLED=1
# Configure the same value on router and runner so the edge rejects oversized uploads first.
MAX_BODY_BYTES=1000000
